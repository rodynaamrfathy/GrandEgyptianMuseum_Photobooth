# Copy this file to .env.local and fill in the values for your environment.
# .env.local is gitignored.

# Required: base URL of the API Gateway (without trailing slash)
NEXT_PUBLIC_AWS_API_BASE_URL=https://abc123.execute-api.us-east-1.amazonaws.com/prod/images

# Optional: AWS region. If unset, derived from NEXT_PUBLIC_AWS_API_BASE_URL
# and falls back to us-east-1.
NEXT_PUBLIC_AWS_REGION=us-east-1

# Optional: PNG template for the back of the photobooth card.
# If unset, the bundled Webapp/public/card.svg is used (served by CloudFront
# from the same origin as the app, so no CORS issues).
# Set this to override the bundled template at runtime.
# NEXT_PUBLIC_CARD_TEMPLATE_URL=https://res.cloudinary.com/your-account/image/upload/template.png

# Required: API endpoint that captures visitor emails
NEXT_PUBLIC_SAVE_EMAIL_URL=https://abc123.execute-api.us-east-1.amazonaws.com/prod/save-email
